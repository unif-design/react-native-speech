{
  "name": "@unif/react-native-speech-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug"
  },
  "dependencies": {
    "@unif/react-native-logger": "0.1.3",
    "@unif/react-native-speech": "workspace:*",
    "expo": "58.0.20",
    "expo-asset": "58.0.18",
    "expo-audio": "58.0.10",
    "expo-crypto": "58.0.7",
    "expo-modules-core": "58.0.27",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.25.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/react": "~19.3.0",
    "react-native-builder-bob": "^0.43.2",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
