{
  "name": "@unif/react-native-speech",
  "version": "0.2.0",
  "description": "React Native 音频采集、临时凭证管理、实时语音识别与语音输入",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "unif-react-native-speech-source": {
        "browser": "./src/index.web.ts",
        "default": "./src/index.ts"
      },
      "types": "./lib/typescript/src/index.d.ts",
      "browser": "./lib/module/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./credentials": {
      "unif-react-native-speech-source": "./src/credentials/index.ts",
      "types": "./lib/typescript/src/credentials/index.d.ts",
      "default": "./lib/module/credentials/index.js"
    },
    "./realtime": {
      "unif-react-native-speech-source": {
        "browser": "./src/realtime/index.web.ts",
        "default": "./src/realtime/index.ts"
      },
      "types": "./lib/typescript/src/realtime/index.d.ts",
      "browser": "./lib/module/realtime/index.web.js",
      "default": "./lib/module/realtime/index.js"
    },
    "./capture": {
      "unif-react-native-speech-source": {
        "browser": "./src/capture/index.web.ts",
        "default": "./src/capture/index.ts"
      },
      "types": "./lib/typescript/src/capture/index.d.ts",
      "browser": "./lib/module/capture/index.web.js",
      "default": "./lib/module/capture/index.js"
    },
    "./input": {
      "unif-react-native-speech-source": "./src/input/index.ts",
      "types": "./lib/typescript/src/input/index.d.ts",
      "default": "./lib/module/input/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @unif/react-native-speech-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ example/src --max-warnings=0",
    "test": "jest --config jest.config.cjs --watchman=false",
    "build": "bob build",
    "release": "release-it --only-version",
    "website": "yarn workspace @unif/react-native-speech-website",
    "test:native-boundary": "python3 __tests__/capture/sdk/native_boundary.py --output /tmp/unif-speech-boundary",
    "test:consumer": "node scripts/verify-consumer.cjs",
    "test:scripts": "node --test scripts/verify-consumer.test.cjs",
    "test:web-consumer": "node scripts/verify-web-consumer.cjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unif-design/react-native-speech.git"
  },
  "author": "unif-design",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unif-design/react-native-speech/issues"
  },
  "homepage": "https://unif-design.github.io/react-native-speech/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "@unif/react-native-logger": "0.1.3",
    "commitlint": "^21.2.1",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "expo": "58.0.20",
    "expo-asset": "58.0.18",
    "expo-audio": "58.0.10",
    "expo-modules-core": "58.0.27",
    "hermes-eslint": "0.37.0",
    "jest": "^30.5.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.25.1",
    "react-native-builder-bob": "^0.43.2",
    "release-it": "^19.2.4",
    "test-renderer": "~1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@unif/react-native-logger": "^0.1.3",
    "expo-audio": "58.0.10",
    "react": ">=19.3.1",
    "react-native": ">=0.88.1"
  },
  "workspaces": [
    "example",
    "website"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "dependencies": {
    "react-native-url-polyfill": "^4.0.0",
    "zustand": "^5.0.16"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: 发布 ${version} [skip ci]",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true,
      "releaseName": "发布 ${version}"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "resolutions": {
    "@react-native/eslint-config/eslint-plugin-ft-flow": "3.0.11"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
